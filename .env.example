# Supabase public client settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only secrets. Never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional WhatsApp Cloud API integration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
# Optional template-name overrides:
# WHATSAPP_TEMPLATE_APPROVAL=ee_application_approved
# WHATSAPP_TEMPLATE_REJECTION=ee_application_needs_fix
# WHATSAPP_TEMPLATE_FEE_DUE=ee_fee_due
# WHATSAPP_TEMPLATE_FEE_OVERDUE=ee_fee_overdue
# WHATSAPP_TEMPLATE_HOLIDAY=ee_holiday_notice
# WHATSAPP_TEMPLATE_ASSIGNMENT=ee_vehicle_assignment
# WHATSAPP_TEMPLATE_ANNOUNCEMENT=ee_announcement
# WHATSAPP_TEMPLATE_TEST=hello_world
