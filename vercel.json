{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/fee-reminders?type=due",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/fee-reminders?type=overdue",
      "schedule": "0 4 10 * *"
    },
    {
      "path": "/api/cron/plan-tomorrow",
      "schedule": "30 16 * * *"
    }
  ]
}
